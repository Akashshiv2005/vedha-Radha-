# ==============================================================================
# VEDHA RADHA THANGA MAALIGAI - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Base URL (FastAPI Server)
# Used by frontend client requests (auth, products, admin, gold rates)
# For local development with direct cross-origin API calls: http://127.0.0.1:8000
# Set to "" to use Vite dev server proxy instead
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Backend server target for Vite dev server proxy
BACKEND_URL="http://127.0.0.1:8000"

# Rate Data Provider API Key
# Recommended Provider: GoldAPI.io (https://www.goldapi.io/)
# 1. Sign up for a free account at https://www.goldapi.io/signup
# 2. Copy your API token from the dashboard
# 3. Paste your token below (Do NOT prefix with VITE_ to keep it secret on the server)
GOLD_API_KEY=YOUR_GOLDAPI_KEY_HERE

# Provider Name (default: goldapi)
RATE_DATA_PROVIDER=goldapi

# Cache Time-To-Live in Minutes (default: 10)
# Helps stay well within provider rate limits (e.g. 500 requests/month on free tier)
RATE_CACHE_TTL_MINUTES=10

# Currency Benchmark
PRECIOUS_RATES_CURRENCY=INR
