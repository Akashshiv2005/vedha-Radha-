# ==============================================================================
# VEDHA RADHA THANGAMAALIGAI — FASTAPI BACKEND CONFIGURATION
# ==============================================================================

# Application
PROJECT_NAME="Vedha Radha Thangamaaligai API"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:0000@localhost:5432/vedharadha_db"

# JWT Authentication
# Generate in production using: openssl rand -hex 32
JWT_SECRET_KEY="vr_super_secret_jwt_key_change_in_production_2026_xyz"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (JSON list)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]'

# Admin Bootstrap Credentials (Used by scripts/create_admin.py)
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_EMAIL="admin@vedaradha.com"
ADMIN_BOOTSTRAP_PASSWORD="admin@123"
ADMIN_BOOTSTRAP_FULL_NAME="Administrator"

# Login Rate Limiting (Brute-force protection)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# MinIO Object Storage
MINIO_ENDPOINT="127.0.0.1:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="vedharadha-products"
MINIO_SECURE=false
MINIO_REGION=""
MINIO_AUTO_CREATE_BUCKET=true
MINIO_PRESIGNED_EXPIRY_SECONDS=86400

# Live Precious Metal Rates (OroPocket Public API)
OROPOCKET_PRICE_URL="https://api.oropocket.com/public/prices"
PRICE_CACHE_TTL_SECONDS=120
